\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texloom-math}[2026/10/03 Native TeX semantic math parts]
% BEGIN TEXLOOM PART PREAMBLE
% A transparent marker adds no braces, boxes, or math atoms around its body.
% Some TeX contexts still react to specials (notably a split text ligature or
% limits placed outside a marked large operator). The compiler compares every
% marked asset with a marker-free native compile and rejects layout changes.
\long\def\loompart#1#2{%
  \special{dvisvgm:raw <g data-texloom-part='#1'>}%
  #2\special{dvisvgm:raw </g>}}
% The measured form is explicitly atomic. Mathchoice supplies the surrounding
% style; only the selected box reaches DVI. The dimensions are true TeX box
% dimensions, in TeX pt, while the DVI origin placeholders are SVG coordinates.
\ifdefined\TLPartBoxRegister\else\newbox\TLPartBoxRegister\fi
\def\TLPartBoxOutput#1{%
  % Put the origin special inside the same math atom as its measured box.
  % An outer special can ship before TeX inserts preceding binary/relation
  % glue, reporting a logical box left of the actual box and painted glyphs.
  \hbox{\special{dvisvgm:raw <g data-texloom-part='#1' data-texloom-box='\the\wd\TLPartBoxRegister\space\the\ht\TLPartBoxRegister\space\the\dp\TLPartBoxRegister' data-texloom-x='{?x}' data-texloom-y='{?y}'>}%
  \box\TLPartBoxRegister\special{dvisvgm:raw </g>}}}
\long\def\TLPartBoxMath#1#2#3{%
  \begingroup\setbox\TLPartBoxRegister=\hbox{$\mathsurround=0pt #1#3$}%
  \TLPartBoxOutput{#2}\endgroup}
\long\def\TLPartBoxText#1#2{%
  \begingroup\setbox\TLPartBoxRegister=\hbox{#2}%
  \TLPartBoxOutput{#1}\endgroup}
\long\def\loompartbox#1#2{%
  \ifmmode
    \mathchoice
      {\TLPartBoxMath{\displaystyle}{#1}{#2}}%
      {\TLPartBoxMath{\textstyle}{#1}{#2}}%
      {\TLPartBoxMath{\scriptstyle}{#1}{#2}}%
      {\TLPartBoxMath{\scriptscriptstyle}{#1}{#2}}%
  \else\TLPartBoxText{#1}{#2}\fi}
% END TEXLOOM PART PREAMBLE
\RequirePackage{texloom-expressions}
\newcount\TLPartViewSerial
\TLPartViewSerial=0
% A static paint selection becomes an ordinary independently animatable node.
% The JSON body is verbatim; TeX does not expand or quote it.
\NewDocumentCommand\loompartview{m m +v}{%
  \global\advance\TLPartViewSerial by 1
  \edef\TLEbase{\jobname.tl-part-view-\the\TLPartViewSerial}%
  \immediate\write\TLrecords{\string{"type":"part-view-file","file":"\TLEbase"\string}}%
  \TLEmetadata{id}{#1}\TLEmetadata{source}{#2}\TLEwrite{body}{#3}}
\endinput
